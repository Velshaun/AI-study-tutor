# AI Study Tutor — frontend environment
# Copy to `.env` and fill in. Only VITE_-prefixed vars are exposed to the
# browser, so never put a secret (e.g. the service-role key) here.

# Supabase project URL + anon key. The anon key is safe to ship; RLS enforces
# access. The backend holds the service-role key, not the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the FastAPI backend is reachable.
VITE_API_URL=http://localhost:8000
