# AI Study Tutor — backend environment
# Copy to `.env` and fill in the secrets. Never commit the real .env.

# --- App ---
APP_NAME=AI Study Tutor
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---
# URL + anon key are safe on the client; the service-role key bypasses RLS and
# must stay server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI providers ---
# Gemini generates lectures, domains and Q&A answers. gemini-1.5-* are retired;
# 2.5-flash is the working default and the only cheap tier that supports both
# Google Search grounding and structured JSON output.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# One OpenAI key covers Whisper (speech-to-text) and TTS HD (narration).
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE_MARCUS=onyx
OPENAI_TTS_VOICE_SOPHIA=nova

# --- Storage / uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
STORAGE_BUCKET=sources
LECTURE_AUDIO_BUCKET=lecture-audio
SIGNED_URL_TTL_SECS=3600

# --- Ingestion pipeline ---
# Upper bound on characters sent to Gemini for domain extraction; longer packs
# are sampled head+tail rather than truncated.
MAX_EXTRACT_CHARS=120000
